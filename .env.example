# Copy to .env for local development. Never commit real values.
AI_API_KEY=

# Optional: model/endpoint overrides (config.yaml has the defaults)
RAVEN_MODEL=
RAVEN_BASE_URL=

# Optional: GitHub integration (none of these are needed for the standard
# evaluation path with a local repository or a public issue URL).
#   Option A: a token, e.g. a fine-grained personal access token with
#   read-only "Contents" + "Issues" (+ "Metadata") permissions.
GITHUB_TOKEN=
#   Option B: `/gh login` in the TUI (OAuth device flow) -- set the PUBLIC
#   client id of a GitHub OAuth App with device flow enabled. No secret needed.
RAVEN_GITHUB_CLIENT_ID=
#   Scopes requested by /gh login (default "repo": OAuth has no read-only
#   scope for private repositories; use "public_repo" for public repos only).
RAVEN_GITHUB_SCOPES=
#   Option C: nothing -- an existing GitHub CLI login (`gh auth login`) is used.
